# Public BOT Chain testnet configuration
NEXT_PUBLIC_BOT_CHAIN_RPC_URL=https://rpc.bohr.life
NEXT_PUBLIC_BOT_CHAIN_EXPLORER_URL=https://scan.bohr.life
NEXT_PUBLIC_BOT_CHAIN_ID=968
NEXT_PUBLIC_USDT_ADDRESS=0x75edC9335175Fc0552D51D48439F229c10420fe3

# Set after deployment
NEXT_PUBLIC_CONSERVATIVE_VAULT_ADDRESS=
NEXT_PUBLIC_BALANCED_VAULT_ADDRESS=
NEXT_PUBLIC_AGGRESSIVE_VAULT_ADDRESS=
NEXT_PUBLIC_AGENT_URL=http://localhost:8787

# Server-only values. Never expose these through NEXT_PUBLIC_* variables.
BOT_CHAIN_RPC_URL=https://rpc.bohr.life
BOT_CHAIN_EXPLORER_URL=https://scan.bohr.life
BOT_CHAIN_ID=968
TESTNET_USDT_ADDRESS=0x75edC9335175Fc0552D51D48439F229c10420fe3
GREN_DEPLOYMENT_ARTIFACT=contracts/script/deployments/bot-chain-testnet.json
GREN_OWNER_ADDRESS=
GREN_POLICY_ADMIN_ADDRESS=
GREN_PAUSER_ADDRESS=
GREN_KEEPER_ADDRESS=
CONSERVATIVE_RESERVE_STRATEGY_ADDRESS=
BALANCED_RESERVE_STRATEGY_ADDRESS=
AGGRESSIVE_RESERVE_STRATEGY_ADDRESS=
AGENT_API_KEY=
KEEPER_PRIVATE_KEY=
AGENT_ALLOWED_ORIGINS=http://localhost:3000
AGENT_MAX_REQUEST_BODY_BYTES=65536
AGENT_RATE_LIMIT_WINDOW_MS=60000
AGENT_PREVIEW_RATE_LIMIT=30
AGENT_STATUS_RATE_LIMIT=60
DECISION_STORE_BACKEND=file
DECISION_STORE_PATH=.agent/decisions.json
DECISION_MAX_RECORDS=10000
DECISION_RETENTION_MS=604800000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional model provider. The agent falls back to the deterministic engine.
MODEL_PROVIDER=openai-compatible
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=
MODEL_NAME=openai/gpt-oss-20b
# GROQ_API_KEY=
# Gemini: MODEL_PROVIDER=gemini  MODEL_BASE_URL=https://generativelanguage.googleapis.com/v1beta  MODEL_NAME=gemini-2.0-flash
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# OpenRouter:  MODEL_BASE_URL=https://openrouter.ai/api/v1  MODEL_NAME=openrouter/free
# Cerebras:    MODEL_BASE_URL=https://api.cerebras.ai/v1     MODEL_NAME=gpt-oss-120b
# xAI:         MODEL_BASE_URL=https://api.x.ai/v1            MODEL_NAME=grok-4.6

# Deployment-only values. Never commit populated values.
BOT_CHAIN_TESTNET_RPC_URL=https://rpc.bohr.life
DEPLOYER_PRIVATE_KEY=
POLICY_ADMIN_PRIVATE_KEY=
