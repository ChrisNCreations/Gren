{
  "name": "gren",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gren/web --filter @gren/agent dev",
    "dev:web": "pnpm --filter @gren/web dev",
    "dev:agent": "pnpm --filter @gren/agent dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "deploy:testnet": "powershell -ExecutionPolicy Bypass -File scripts/deploy-testnet.ps1",
    "finalize:deployment": "node scripts/finalize-testnet-deployment.mjs",
    "sync:public-env": "node scripts/sync-public-env.mjs",
    "prototype": "python -m http.server 4173 --directory prototype"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.18.0",
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "uuid": "11.1.1",
      "ws@8.18.0": "8.21.3"
    }
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
